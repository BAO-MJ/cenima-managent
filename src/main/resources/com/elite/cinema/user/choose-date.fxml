<AnchorPane prefHeight="500.0" prefWidth="674.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.elite.cinema.controllers.user.ChooseDateController">
