<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      styleClass="cart-item" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <ImageView fx:id="itemImage" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true"/>
    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
        <HBox.margin>
            <Insets left="10.0"/>
        </HBox.margin>
        <Label fx:id="itemNameLabel" styleClass="item-name" text="Item Name"/>
        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <Label fx:id="itemPriceLabel" styleClass="item-price" text="50,000 VNĐ"/>
            <Label text="x"/>
            <Label fx:id="itemQuantityLabel" styleClass="item-quantity" text="2"/>
        </HBox>
    </VBox>
    <Label fx:id="itemTotalLabel" styleClass="item-total" text="100,000 VNĐ" HBox.hgrow="NEVER"/>
    <Button fx:id="removeButton" mnemonicParsing="false" styleClass="remove-button">
        <graphic>
            <FontIcon iconLiteral="fas-times"/>
        </graphic>
        <HBox.margin>
            <Insets left="10.0"/>
        </HBox.margin>
    </Button>
</HBox>