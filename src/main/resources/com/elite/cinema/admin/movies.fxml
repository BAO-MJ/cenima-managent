<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane minHeight="580.0" prefHeight="580.0" prefWidth="1040.0" stylesheets="@crud.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.elite.cinema.controllers.MoviesController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="h2" text="Movies Management">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="addButton" onAction="#addNewMovie">
                    <graphic>
                        <FontIcon iconLiteral="fas-plus" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Add New Movie" />
                    </tooltip>
                </Button>
                <Button fx:id="refreshButton" onAction="#fetchMovies">
                    <graphic>
                        <FontIcon iconLiteral="fas-sync" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Refresh Movies" />
                    </tooltip>
                </Button>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <FontIcon iconLiteral="fas-search" />
                <TextField fx:id="searchField" promptText="Search movies..." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="filterComboBox" promptText="Filter by rating">
                    <tooltip>
                        <Tooltip text="Filter by Rating" />
                    </tooltip>
                </ComboBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.65">
            <VBox>
                <TableView fx:id="moviesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn maxWidth="1.7976931348623157E308" prefWidth="-1.0" text="Title" />
                        <TableColumn maxWidth="1.7976931348623157E308" prefWidth="-1.0" text="Duration" />
                        <TableColumn maxWidth="1.7976931348623157E308" prefWidth="-1.0" text="Rating" />
                  <TableColumn maxWidth="1.7976931348623157E308" prefWidth="-1.0" text="Release Date" />
                  <TableColumn maxWidth="1.7976931348623157E308" prefWidth="-1.0" text="End Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No movies available" />
                    </placeholder>
                </TableView>
            </VBox>

            <ScrollPane fitToWidth="true" pannable="true">
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <ImageView id="poster" fx:id="moviePoster" fitHeight="300.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../../image/default-poster.png" />
                    </ImageView>

                    <Label id="title" fx:id="movieTitle" alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" styleClass="h3" textAlignment="CENTER" wrapText="true" />

                    <HBox alignment="CENTER" spacing="8.0">
                        <FontIcon iconLiteral="fas-clock" />
                        <Label id="duration" fx:id="movieDuration" text="Duration: ??? minutes" />
                    </HBox>

                    <VBox id="subinfo" alignment="CENTER_LEFT" spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconLiteral="fas-film" />
                            <Label fx:id="movieGenre" text="Genre: ???" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconLiteral="fas-user" />
                            <Label fx:id="movieDirector" text="Director: ???" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconLiteral="fas-star" />
                            <Label fx:id="movieRating" text="Rating: ???" />
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Button fx:id="editButton" onAction="#onEditMovie" text="Edit">
                            <graphic>
                                <FontIcon iconLiteral="fas-edit" />
                            </graphic>
                        </Button>
                        <Button fx:id="deleteButton" onAction="#onDeleteMovie" text="Delete">
                            <graphic>
                                <FontIcon iconLiteral="fas-trash" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
